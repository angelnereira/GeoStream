# Portal público de GeoStream (ADR-0034). Las variables ${...} las sustituye la imagen de nginx
# al arrancar (NGINX_ENVSUBST_FILTER limita cuáles); las de nginx ($host, $uri…) no se tocan.
# Límite de tasa del proxy de la API y de las teselas, por IP (ADR-0035, 10 T-39).
limit_req_zone $binary_remote_addr zone=portal_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=portal_tiles:10m rate=60r/s;
# Caché de teselas: las teselas son públicas y cambian solo al reconstruir el servicio.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=portal_tiles_cache:10m max_size=512m inactive=7d use_temp_path=off;

# IP del cliente tal como la vio el borde de Railway: la última entrada de X-Forwarded-For (la añade el
# borde; las anteriores las escribe el cliente y se pueden falsear). La API limita el registro por esa IP.
map $http_x_forwarded_for $console_client_ip {
    default $remote_addr;
    "~(?<last>[^,\s]+)\s*$" $last;
}
limit_req_zone $binary_remote_addr zone=portal_console:10m rate=5r/s;

server {
    listen ${PORT};
    # Los destinos se resuelven en cada petición: el portal arranca aunque el servicio de teselas aún no exista.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=on;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # `connect-src 'self'`: el portal solo habla con su propio origen; el estado pasa por el proxy
    # de abajo. Se ampliará con el mapa propio y la API cuando existan (T-F15-10, T-F15-12).
    # Flutter necesita 'wasm-unsafe-eval' y estilos en línea. Las cabeceras comunes van en
    # security-headers.conf, incluido en cada location (add_header no se hereda si el location
    # define otro).
    set $app_csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'";

    # Estado en vivo: proxy del `/health/ready` público de la API (mismo origen, sin CORS).
    location = /status/ready {
        proxy_pass ${PORTAL_API_UPSTREAM}/health/ready;
        proxy_ssl_server_name on;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_hide_header Set-Cookie;
        # 502/504 llegan al cliente como «sin datos», nunca como disponible.
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }

    # Proxy de SOLO LECTURA de la API (ADR-0035). Únicas rutas reenviadas: sesiones, una sesión, sus
    # miembros y su snapshot. Cualquier otra ruta o método devuelve 404 en el borde, así que el portal no
    # puede escribir aunque la API key lo permita. Sin registro de cabeceras: `Authorization` no llega a ningún log.
    location ~ "^/api/v1/sessions(/ses_[0-9a-f]{32}(/(members|snapshot))?)?$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 404; }
        access_log off;
        limit_req zone=portal_api burst=20 nodelay;
        # `set` antes de `rewrite … break`: el `break` corta las directivas de reescritura que siguen.
        set $api_upstream ${PORTAL_API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_hide_header Set-Cookie;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }
    # Consola de desarrolladores (FR-CON-001..012): registro, inicio de sesión, organizaciones, proyectos y
    # API keys. Solo `/v1/console/…` y solo los métodos del contrato; el resto de `/api/` sigue siendo de lectura.
    # Sin caché, sin registro de cabeceras ni de cuerpos: llevan el token de sesión, el código y el secreto.
    location ~ "^/api/v1/console/(auth/(code|verify|logout)|me|organizations(/ten_[0-9a-f]{32}(/projects(/app_[0-9a-f]{32}(/keys(/key_[0-9a-f]{32})?)?)?)?)?)$" {
        if ($request_method !~ ^(GET|POST|PATCH|DELETE)$) { return 404; }
        access_log off;
        limit_req zone=portal_console burst=20 nodelay;
        client_max_body_size 8k;
        set $api_upstream ${PORTAL_API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $console_client_ip;
        proxy_set_header X-Real-IP $console_client_ip;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_hide_header Set-Cookie;
        proxy_no_cache 1;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }
    location /api/ {
        return 404;
    }

    # Teselas y glifos del mapa propio (servicio `tiles`, ADR-0034 §6), con caché.
    location /tiles/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 404; }
        access_log off;
        limit_req zone=portal_tiles burst=200 nodelay;
        set $tiles_upstream ${PORTAL_TILES_UPSTREAM};
        rewrite ^/tiles/(.*)$ /$1 break;
        proxy_pass $tiles_upstream;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_cache portal_tiles_cache;
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Tile-Cache $upstream_cache_status always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }

    # Estilo del mapa propio y MapLibre alojado en el portal (sin CDN).
    location /map/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }
    # MapLibre 6 se distribuye como módulos ES: sin este tipo MIME el navegador se niega a cargarlos.
    location ~ ^/vendor/.*\.mjs$ {
        types { text/javascript mjs; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        # Un worker hereda la CSP de la respuesta de SU script, no la de la página: el worker de MapLibre
        # (maplibre-gl-worker.mjs) pide las teselas, así que necesita `connect-src 'self'`.
        add_header Content-Security-Policy "default-src 'none'; connect-src 'self'" always;
    }
    location /vendor/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        add_header Content-Security-Policy "default-src 'none'; connect-src 'self'" always;
    }

    # La referencia de la API (Redoc) usa estilos en línea (styled-components) y un worker en un blob.
    # Todo lo demás sigue siendo del propio origen: sin CDN y sin fuentes de terceros.
    location = /docs/api.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'" always;
    }

    # Documentación y contratos publicados (HTML estático generado en la construcción).
    location /docs/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;
    }
    location /contracts/ {
        try_files $uri $uri/ =404;
        default_type text/plain;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'" always;
    }

    # La aplicación Flutter: el HTML y el cargador no se cachean; los activos con hash, sí.
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Content-Security-Policy $app_csp always;
        add_header Cache-Control "no-cache" always;
    }
    location = /flutter_service_worker.js {
        include /etc/nginx/security-headers.conf;
        add_header Content-Security-Policy $app_csp always;
        add_header Cache-Control "no-cache" always;
    }
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Content-Security-Policy $app_csp always;
        try_files $uri $uri/ /index.html;
    }
}
