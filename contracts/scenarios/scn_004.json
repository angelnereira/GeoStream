{
  "id": "SCN-004",
  "title": "Conocer el ID de sesión no da acceso",
  "requirements": [
    "FR-API-006",
    "FR-STR-002",
    "NFR-SEC-004"
  ],
  "actors": {
    "backend": {
      "kind": "application",
      "scopes": [
        "tokens:mint",
        "sessions:read",
        "sessions:write",
        "members:write",
        "invitations:write",
        "subjects:manage"
      ]
    },
    "alice": {
      "kind": "device",
      "external_subject_id": "alice",
      "platform": "PLATFORM_ANDROID"
    },
    "bob": {
      "kind": "device",
      "external_subject_id": "bob",
      "platform": "PLATFORM_ANDROID"
    },
    "carol": {
      "kind": "device",
      "external_subject_id": "carol",
      "platform": "PLATFORM_ANDROID"
    },
    "mallory": {
      "kind": "device",
      "external_subject_id": "mallory",
      "platform": "PLATFORM_ANDROID"
    }
  },
  "steps": [
    {
      "actor": "backend",
      "op": "http",
      "method": "POST",
      "path": "/v1/sessions",
      "body": {
        "mode": "MANY_TO_MANY",
        "expires_in_seconds": 3600,
        "initial_members": [
          {
            "external_subject_id": "alice"
          },
          {
            "external_subject_id": "bob"
          },
          {
            "external_subject_id": "carol",
            "capabilities": {
              "publish": false,
              "read": true,
              "invite": false,
              "manage": false
            }
          }
        ]
      },
      "expect": {
        "status": 201
      },
      "capture": {
        "session_id": "$.id"
      }
    },
    {
      "actor": "backend",
      "op": "http",
      "method": "GET",
      "path": "/v1/sessions/{{session_id}}/members",
      "expect": {
        "status": 200
      },
      "capture": {
        "alice_member_id": "$.data[?(@.external_subject_id=='alice')].id",
        "bob_member_id": "$.data[?(@.external_subject_id=='bob')].id",
        "carol_member_id": "$.data[?(@.external_subject_id=='carol')].id"
      }
    },
    {
      "actor": "alice",
      "op": "stream.connect",
      "expect": "ready"
    },
    {
      "actor": "alice",
      "op": "http",
      "method": "PUT",
      "path": "/v1/sessions/{{session_id}}/members/me/sharing",
      "body": {
        "sharing": true
      },
      "expect": {
        "status": 200,
        "json": {
          "sharing": true
        }
      }
    },
    {
      "actor": "mallory",
      "op": "stream.connect",
      "expect": "ready"
    },
    {
      "actor": "mallory",
      "op": "http",
      "method": "GET",
      "path": "/v1/sessions/{{session_id}}",
      "expect": {
        "status": 404,
        "json": {
          "code": "NOT_FOUND"
        }
      }
    },
    {
      "actor": "mallory",
      "op": "http",
      "method": "GET",
      "path": "/v1/sessions/ses_0192b6c0a1e47c3f9d2a7b5e8f1c0d3a",
      "expect": {
        "status": 404,
        "json": {
          "code": "NOT_FOUND"
        }
      },
      "note": "misma respuesta que para un ID inexistente"
    },
    {
      "actor": "mallory",
      "op": "http",
      "method": "GET",
      "path": "/v1/sessions/{{session_id}}/snapshot",
      "expect": {
        "status": 404
      }
    },
    {
      "actor": "mallory",
      "op": "stream.send",
      "message": {
        "subscribe": {
          "session_id": "{{session_id}}"
        }
      },
      "expect_reply": {
        "error": {
          "code": "ERROR_CODE_NOT_FOUND"
        }
      }
    },
    {
      "actor": "alice",
      "op": "stream.send",
      "message": {
        "publish_location": {
          "session_id": "{{session_id}}",
          "samples": [
            {
              "sequence": "1",
              "captured_at": "{{now-1s}}",
              "position": {
                "latitude": 8.9824,
                "longitude": -79.5199,
                "horizontal_accuracy_m": 8.5
              },
              "quality": {
                "source": "LOCATION_SOURCE_GNSS",
                "kind": "LOCATION_KIND_MEASURED"
              }
            }
          ]
        }
      },
      "expect_reply": {
        "publish_ack": {
          "results": [
            {
              "sequence": "1",
              "status": "SAMPLE_STATUS_ACCEPTED"
            }
          ]
        }
      }
    },
    {
      "actor": "mallory",
      "op": "stream.expect_none",
      "message": "location_update",
      "for_ms": 1000
    },
    {
      "actor": "mallory",
      "op": "stream.send",
      "message": {
        "publish_location": {
          "session_id": "{{session_id}}",
          "samples": [
            {
              "sequence": "1",
              "captured_at": "{{now-1s}}",
              "position": {
                "latitude": 8.9824,
                "longitude": -79.5199,
                "horizontal_accuracy_m": 8.5
              },
              "quality": {
                "source": "LOCATION_SOURCE_GNSS",
                "kind": "LOCATION_KIND_MEASURED"
              }
            }
          ]
        }
      },
      "expect_reply": {
        "publish_ack": {
          "request_error": "ERROR_CODE_NOT_FOUND"
        }
      }
    }
  ]
}
