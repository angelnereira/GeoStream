  "constants": {
    "comment": "Constantes de docs/17_CONFIGURATION.md §2.11. No son configurables.",
    "initial_speed_sigma_mps": 10.0,
    "zupt_sigma_mps": 0.1,
    "motion_threshold_mps": 0.5,
    "process_noise_stationary_mps2": 0.05,
