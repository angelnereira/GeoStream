{
  "description": "Vectores del motor de trayectoria del servidor (docs/22_TRACKING_ENGINE.md §4). Fijan el comportamiento del filtro de Kalman, la puerta de plausibilidad, el odómetro y las paradas online. Formato en contracts/README.md §4.7.",
  "version": 1,
  "server_now": "2026-01-15T12:00:00.000Z",
  "policy": {
    "track_estimates_enabled": true,
    "track_max_speed_mps": 70.0,
    "track_max_accel_mps2": 8.0,
    "track_low_accuracy_m": 100.0,
    "track_frozen_fix_count": 5,
    "track_reset_gap_s": 60,
    "track_accuracy_sigma_factor": 1.0,
    "track_outlier_chi2": 13.82,
    "track_outlier_reset_count": 3,
    "track_odometer_noise_factor": 1.0,
    "track_odometer_bridge_gaps": true,
    "track_stop_radius_m": 50.0,
    "track_stop_min_duration_s": 120,
    "track_stop_exit_confirm": 2,
    "track_lost_after_s": 30
