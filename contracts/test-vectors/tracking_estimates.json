    "process_noise_running_mps2": 1.0,
    "process_noise_cycling_mps2": 1.0,
    "process_noise_automotive_mps2": 2.0,
    "process_noise_unknown_mps2": 1.5,
    "speed_table_max_mps": {
      "WALKING": 2.0,
      "RUNNING": 8.0,
      "CYCLING": 12.0,
      "AUTOMOTIVE": 70.0,
      "UNKNOWN": 70.0
    },
    "plausibility_penalty_weights": {
      "speed": 0.8,
      "outlier": 0.6,
      "mock": 0.5,
      "frozen_fix": 0.5,
      "accel": 0.4,
      "low_accuracy": 0.2,
      "network_only": 0.1
    }
  },
  "tolerances": {
    "comment": "Comparación numérica: |esperado - obtenido| <= valor. La posición estimada se compara en metros de gran distancia.",
    "position_m": 2.0,
    "speed_mps": 0.5,
    "heading_deg": 10.0,
    "accuracy_m": 1.0,
    "confidence": 0.05,
    "odometer_m": 3.0
  },
  "flags": {
    "comment": "Conjunto de banderas esperadas. El orden no importa; deben coincidir como conjunto.",
    "none": [],
    "single": ["LOW_ACCURACY"],
    "frozen": ["FROZEN_FIX"],
    "mock": ["MOCK_FLAGGED", "NETWORK_ONLY"],
    "speed": ["EXCESSIVE_SPEED"],
    "outlier": ["OUTLIER_JUMP"],
    "accel": ["IMPLAUSIBLE_ACCEL"]
  },
  "cases": [
