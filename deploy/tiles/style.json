{
  "version": 8,
  "name": "GeoStream (OpenMapTiles)",
  "metadata": {
    "geostream:source": "own tiles (ADR-0034 §6, FR-MAP-007)"
  },
  "sources": {
    "geostream": {
      "type": "vector",
      "tiles": [
        "/tiles/panama/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">© OpenStreetMap contributors</a> · <a href=\"https://openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">© OpenMapTiles</a>"
    }
  },
  "glyphs": "/tiles/font/{fontstack}/{range}",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2efe9"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "geostream",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#d3e3c4",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "geostream",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "grass",
        "farmland"
      ],
      "paint": {
        "fill-color": "#e1ecd1",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "geostream",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe6bf",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "geostream",
      "source-layer": "landuse",
      "filter": [
        "==",
        "class",
        "residential"
      ],
      "minzoom": 9,
      "paint": {
        "fill-color": "#ebe7df"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "geostream",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a5c8e8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "geostream",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a5c8e8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          14,
          2
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "geostream",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#dcd6cb",
        "fill-outline-color": "#c9c2b5"
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "geostream",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "minor",
          "service",
          "track",
          "path"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          12,
          0.3,
          18,
          6
        ]
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "geostream",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "tertiary"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          18,
          10
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "geostream",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "secondary"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fbe8b0",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          18,
          12
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "geostream",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "primary"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f9d98c",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          18,
          14
        ]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "geostream",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "in",
          "class",
          "trunk",
          "motorway"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f4c26b",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          5,
          0.6,
          18,
          16
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "geostream",
      "source-layer": "boundary",
      "filter": [
        "==",
        "admin_level",
        2
      ],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": 1.2,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "geostream",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#5d7fa3",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "geostream",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "geostream",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "in",
        "class",
        "suburb",
        "neighbourhood",
        "quarter"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#6b6b6b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "geostream",
      "source-layer": "place",
      "minzoom": 8,
      "filter": [
        "in",
        "class",
        "town",
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "geostream",
      "source-layer": "place",
      "filter": [
        "==",
        "class",
        "city"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          12,
          12,
          18
        ]
      },
      "paint": {
        "text-color": "#222",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}