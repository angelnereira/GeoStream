# GeoStream — Variables de entorno de referencia para desarrollo local
# Referencia: docs/17_CONFIGURATION.md, docs/16_OPERATIONS.md §10
# ADVERTENCIA: Estos valores son exclusivamente para desarrollo y pruebas (dev/test).
# En producción (prod) el uso de estos secretos de ejemplo detiene el arranque.

# General (17 §2.1)
GS_ENV=dev
GS_HTTP_ADDR=0.0.0.0:8080
GS_ADMIN_ADDR=127.0.0.1:9090
GS_PUBLIC_BASE_URL=http://localhost:8080
GS_LOG_FORMAT=pretty
GS_LOG_LEVEL=info
GS_LOG_UNSAFE_LOCATIONS=false
GS_SHUTDOWN_GRACE_S=30

# PostgreSQL (17 §2.2)
GS_DATABASE_URL=postgres://geostream:geostream_dev_password@localhost:5432/geostream_dev
GS_DATABASE_MAX_CONNECTIONS=20
GS_DATABASE_CONNECT_TIMEOUT_MS=5000
GS_DATABASE_STATEMENT_TIMEOUT_MS=5000
GS_AUTO_MIGRATE=true

# Almacén efímero y bus (17 §2.3)
GS_STATE_BACKEND=memory
GS_REDIS_URL=redis://localhost:6379
GS_REDIS_KEY_PREFIX=gs
GS_PRESENCE_TTL_S=90
GS_AUTHZ_CACHE_TTL_MS=5000

# Autenticación y cifrado (17 §2.4)
GS_JWT_ISSUER=http://localhost:8080
GS_JWT_KEYS_DIR=./dev_keys
GS_JWT_ACTIVE_KID=dev-key-1
GS_JWT_LEEWAY_S=30
GS_TOKEN_MIN_TTL_S=300
GS_TOKEN_DEFAULT_TTL_S=900
GS_TOKEN_MAX_TTL_S=3600
GS_TICKET_TTL_S=30
# Clave AES-256-GCM activa (32 bytes en base64) para desarrollo
GS_DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Límites REST (17 §2.5)
GS_REST_MAX_BODY_BYTES=65536
GS_REST_RATE_LIMIT_DEVICE_RPM=120
GS_REST_RATE_LIMIT_APP_RPM=6000
GS_INVITE_REDEEM_RPM=10
GS_AUTH_FAILURE_RPM_PER_IP=60

# Stream (17 §2.6)
GS_STREAM_JSON_ENABLED=true
GS_STREAM_MAX_CONNECTIONS=1000
GS_STREAM_MAX_FRAME_BYTES=16384
GS_STREAM_HEARTBEAT_INTERVAL_MS=20000
GS_STREAM_IDLE_TIMEOUT_MS=60000
GS_STREAM_MAX_SUBSCRIPTIONS=20
GS_STREAM_MAX_SUBSCRIPTIONS_APP=1000
GS_STREAM_OFFLINE_GRACE_MS=10000
